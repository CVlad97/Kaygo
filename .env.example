# ─── Supabase (required) ──────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── API / Backend (required) ─────────────────────────────────────
# Base URL of the deployed API server
VITE_API_BASE_URL=https://api.example.com

# ─── App (required) ───────────────────────────────────────────────
# Port and base path for local dev / GitHub Pages
PORT=4173
BASE_PATH=/Kaygo/

# ─── WhatsApp (optional) ──────────────────────────────────────────
# Falls back to the pilot WhatsApp Business number if omitted
VITE_WHATSAPP_URL=https://wa.me/596696653589

# ─── GitHub Actions (optional, CI only) ──────────────────────────
# KAYGO_API_BASE_URL=https://api.example.com
# KAYGO_WHATSAPP_URL=https://wa.me/596696653589